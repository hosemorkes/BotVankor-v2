# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Weather API Key
WEATHER_API_KEY=your_weather_api_key_here

# Координаты Ванкорского месторождения
VANKOR_LATITUDE=69.5
VANKOR_LONGITUDE=88.0
VANKOR_NAME=Ванкорское месторождение

# Координаты Игарки
IGARKA_LATITUDE=67.4
IGARKA_LONGITUDE=86.6
IGARKA_NAME=Игарка

# Database
DATABASE_PATH=data/bot.db

# Logging
LOG_LEVEL=INFO

# Shadowsocks proxy configuration
# Адрес зарубежного VPS с ssserver
SS_SERVER=your_vps_ip_address
SS_PORT=8388
# Пароль base64-закодированный для методов 2022-*
SS_PASSWORD=your_password_base64
# Метод шифрования
SS_METHOD=2022-blake3-aes-256-gcm

# URL прокси для подключения бота к Telegram API
# Если не установлен, бот работает без прокси
PROXY_URL=socks5://sslocal:1080
